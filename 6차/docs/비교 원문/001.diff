+        # 감시자 기동 중에는 조회가 학습자의 작업 잠금을 먼저 잡지 않습니다.
+        with worker_lock(PRIVATE / "운용감시잠금"):
+            with worker_lock():
+                return False
+    except RuntimeError:
+        return True
