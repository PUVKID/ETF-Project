+/* Astryx 공식 토큰과 기존 DOM의 연결입니다. React 컴포넌트 직접 사용과 구분합니다. */
+:root,[data-theme] {
+  --bg:var(--color-background-body);--page:var(--color-background-body);--surface:var(--color-background-surface);
+  --ink:var(--color-text-primary);--muted:var(--color-text-secondary);--line:var(--color-border);
+  --accent:var(--color-primary);--teal:var(--color-primary);--mint:var(--color-primary);
+  --accent-soft:var(--color-background-selected);--tint:var(--color-background-hover);--tint-strong:var(--color-background-selected);
+}
+@font-face{font-family:NanumGothic;src:url('/assets/NanumGothic-Bold.ttf') format('truetype');font-weight:700;font-style:normal;font-display:swap}
+html{background:var(--color-background-body);color:var(--color-text-primary);scroll-padding-top:24px}
+body{background:var(--color-background-body);color:var(--color-text-primary);font-family:var(--font-family-body);font-weight:700;line-height:1.7}
+button,input,select,textarea,table,summary{font-family:var(--font-family-body);font-weight:700}
+h1,h2,h3,h4{font-family:var(--font-family-heading);color:var(--color-text-primary);text-wrap:balance}
+button,select,input:not([type=checkbox]):not([type=radio]),textarea{min-height:var(--astryx-control-height);border:1px solid var(--color-border);border-radius:var(--radius-element);background:var(--color-background-surface);color:var(--color-text-primary);padding:10px 14px;font-size:13px;transition:background .16s,border-color .16s,box-shadow .16s}
+button{cursor:pointer;min-width:44px;touch-action:manipulation}
+button:hover:not(:disabled),select:hover{background:var(--color-background-hover);border-color:var(--color-border-emphasized)}
+button:active:not(:disabled){background:var(--color-background-selected)}
+button:disabled,input:disabled,select:disabled{color:var(--color-text-disabled);opacity:.7;cursor:not-allowed}
+button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,a:focus-visible,[tabindex]:focus-visible{outline:var(--astryx-focus-width) solid var(--color-primary);outline-offset:3px}
+button.primary,[data-variant=primary]{background:var(--color-background-primary);color:var(--color-text-on-primary);border-color:var(--color-primary)}
+button.primary:hover:not(:disabled){background:var(--color-primary);box-shadow:0 0 0 3px var(--color-background-selected)}
+button.secondary,button.quiet,.text-button{background:var(--color-background-surface);color:var(--color-text-primary)}
+.sidebar{background:var(--color-background-surface);border-color:var(--color-border)}
+.sidebar nav{gap:8px}.sidebar nav a,.sidebar nav button,.tabs button{min-height:44px;border-radius:var(--radius-element);font-size:14px;line-height:1.5}
+.sidebar nav a:hover,.sidebar nav button:hover{background:var(--color-background-hover)}
+.sidebar nav a.selected,.sidebar nav button.active,.sidebar nav button[aria-current=page],.tabs button[aria-selected=true]{background:var(--color-background-selected);color:var(--color-primary);border-color:var(--color-border)}
+.table-wrap,.table-scroll{border:1px solid var(--color-border);border-radius:var(--radius-container);background:var(--color-background-surface);overflow-x:auto;max-width:100%}
+table{color:var(--color-text-primary);font-size:12px;line-height:1.65}
+th{background:var(--color-background-hover);color:var(--color-text-secondary);font-size:11px;padding:14px 16px}
+td{padding:15px 16px;border-color:var(--color-border)}tbody tr:hover{background:var(--color-background-hover)}
+details{border-color:var(--color-border);border-radius:var(--radius-element)}summary{cursor:pointer;min-height:44px;padding-top:10px;padding-bottom:10px}
+pre,.logs,.log-lines{color:var(--color-text-primary);background:var(--color-background-surface);border-color:var(--color-border);border-radius:var(--radius-element)}
+dialog,[role=dialog],.modal,.tooltip,.chart-tooltip{background:var(--color-background-surface);color:var(--color-text-primary);border:1px solid var(--color-border);border-radius:var(--radius-container)}
+progress{accent-color:var(--color-primary)}progress::-webkit-progress-value{background:var(--color-primary)}progress::-webkit-progress-bar{background:var(--color-background-selected)}
+.astryx-design-label{font-size:10px;letter-spacing:.08em;color:var(--color-text-secondary);margin-top:14px}
+@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
+@media(max-width:760px){button,select,input{font-size:13px}.sidebar nav a,.sidebar nav button,.tabs button{font-size:12px}table{font-size:11px}th,td{padding:12px}.section-heading,.page-header{flex-wrap:wrap}.actions{flex-wrap:wrap}.header-tools{flex-wrap:wrap}}
+main{padding-left:32px;padding-right:32px}.topbar{height:78px}.section{padding-top:28px;padding-bottom:32px}.section-heading{margin-bottom:24px}h1{font-size:30px;letter-spacing:-1px}.overview-grid{gap:24px}.paper-summary,.performance,.learning-detail,.scenario-result{background:var(--color-background-surface);border:1px solid var(--color-border);border-radius:var(--radius-container);padding:24px;min-width:0}.paper-summary h2,.panel-title h2{font-size:14px}.total-value{font-size:40px}.metric-strip{gap:12px;border:0;padding:0}.metric-strip>div{border:1px solid var(--color-border);border-radius:var(--radius-element);padding:16px;background:var(--color-background-surface);min-width:0}.metric-strip>div:first-child{padding:16px}.metric-strip>div:last-child{border:1px solid var(--color-border)}.workflow-viewport{border:1px solid var(--color-border);border-radius:var(--radius-container)}.input-unit{border-radius:var(--radius-element);background:var(--color-background-surface)}.input-unit input{border:0;background:transparent;padding:0;min-height:32px}.status-badge,.mode-label{border-radius:var(--radius-inner);background:var(--color-background-selected);color:var(--color-primary)}@media(max-width:980px){.overview-grid{grid-template-columns:1fr}.workflow-layout{grid-template-columns:1fr}}@media(max-width:760px){main{padding:0 16px}.paper-summary,.performance,.learning-detail,.scenario-result{padding:18px}.metric-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.total-value{font-size:34px}.topbar{height:auto;min-height:70px;gap:10px;flex-wrap:wrap;padding:12px 0}.topbar>div{gap:10px}.sidebar{padding:16px}.section-heading h1{font-size:27px}.actions{width:100%}.actions button{flex:1}.scenario-result{border-left:1px solid var(--color-border)}.section{scroll-margin-top:16px}}
+
+/* 기존 화면과 공식 컴포넌트의 개별 높이보다 실제 Astryx 조작부 토큰을 우선합니다. */
+html[data-theme] button,html[data-theme] select,html[data-theme] textarea,
+html[data-theme] input:not([type=checkbox]):not([type=radio]){min-height:var(--astryx-control-height)}
+html[data-theme] button{min-width:var(--astryx-control-height)}
