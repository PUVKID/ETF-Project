+        self.assertEqual(calls[1][1],'/api/jobs')
+        self.assertEqual(calls[1][2],b'{"action":"start"}')
+        self.assertEqual(calls[1][4],'1')
+
+if __name__=='__main__':unittest.main(verbosity=2)
