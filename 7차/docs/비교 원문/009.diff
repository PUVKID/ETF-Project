++@contextmanager
++def running(server):
++    thread=threading.Thread(target=server.serve_forever,daemon=True)
++    thread.start()
++    try:
++        yield server
++    finally:
++        server.shutdown()
++        server.server_close()
++        thread.join(timeout=2)
